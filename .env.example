# Copy the lines you need into .env.local (local) and into
# Vercel → Project → Settings → Environment Variables (production).

# ─── Supabase (Project Settings → API Keys / Data API) ─────────────────────
# Without these two, the blog runs on an in-memory demo store.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ─── Admin panel ───────────────────────────────────────────────────────────
# Long random string that signs the login cookie. Generate one with:
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=reyhan_eren_aile_danismani_admin_session_secret
# PIN used only the very first time (before it's changed in /admin/ayarlar).
ADMIN_PIN=1234
